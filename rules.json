      "regexFilter": "^https?://(?:[a-z0-9-]+\\.)*wikipedia\\.org/w/index\\.php\\?.*(?:title=(?:Special:|Special%3A|File:|File%3A|Image:|Wikipedia:|Help:|User:|Talk:|Template:|Module:|MediaWiki:|Draft:|Portal:|Category:|Media:|TimedText:|WP:|WT:|Project:)|search=)",
