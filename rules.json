    "condition": {
      "regexFilter": "^https?://(?:[a-z0-9-]+\\.)*wikipedia\\.org/wiki/(?:Special:|Special%3A|File:|File%3A|Image:|Image%3A|Wikipedia:|Wikipedia%3A|Help:|Help%3A|User:|User%3A|Talk:|Talk%3A|Template:|Template%3A|Module:|Module%3A|MediaWiki:|MediaWiki%3A|Draft:|Draft%3A|Portal:|Portal%3A|Category:|Category%3A|Media:|TimedText:|WP:|WT:|Project:)(?:.*)$",
      "resourceTypes": ["main_frame"]
